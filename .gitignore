# Local-only reference and context. Kept on disk, never committed.
#
# GROUND_TRUTH.md is the authoritative schema/compliance reference and
# CLAUDE.md is the build's decision log -- both are working material rather
# than part of what the project ships.
CLAUDE.md
GROUND_TRUTH.md

# Secrets -- never commit any of these.
.env
.env.*
*.pem
*.key
*.p12
secrets.json
.anthropic/
.claude/settings.local.json

# Frontend build artefacts.
frontend/node_modules/
frontend/dist/
# Synced copy of data/batch_results.json -- produced by `npm run sync-data`,
# never edited by hand. One source of truth for the run.
frontend/public/batch_results.json
frontend/tsconfig.tsbuildinfo
