# Copy to .env and fill in what you have. Nothing here is required --
# with no keys set, the recommendation layer runs on the offline
# deterministic stub and every other layer is unaffected.
#
# Model client selection order (data/run_batch.py, backend/app entry
# points): Gemini, with Groq as an automatic fallback if both keys below
# are set -> Groq alone -> Anthropic -> the offline stub. Gemini is
# checked first: it's free-tier and gives the same schema-validated
# structured-output guarantee Anthropic's paid API does.

# Free tier at ai.google.dev. GOOGLE_API_KEY also works if that's what
# you already have set for other Google AI tooling.
GEMINI_API_KEY=

# Free tier at console.groq.com. Used as the fallback when Gemini is
# unavailable or errors, or alone if only this key is set.
GROQ_API_KEY=

# Paid. Only read if neither key above is set.
ANTHROPIC_API_KEY=

# Comma-separated origins allowed to read the API. Defaults to the four
# localhost dev/preview origins if unset -- only needed to override that.
REVORA_CORS_ORIGINS=

# Operational kill switches, both default off. See CLAUDE.md for scope.
REVORA_DISABLE_LLM=
REVORA_DISABLED_RULES=
