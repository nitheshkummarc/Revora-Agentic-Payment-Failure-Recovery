# Copy to .env and fill in what you have. Nothing here is required --
# with no keys set, the recommendation layer runs on the offline
# deterministic stub and every other layer is unaffected.
#
# Model client selection order (data/run_batch.py, backend/app entry
# points): Groq, with Gemini as an automatic fallback if both keys below
# are set -> Gemini alone -> the offline stub. Groq is checked first:
# both providers give the same schema-validated structured-output
# guarantee, and Groq's free tier can carry a full 500-row batch without
# hitting the request quota Gemini's caps out at.

# Free tier at console.groq.com. The default provider.
GROQ_API_KEY=

# Free tier at ai.google.dev. Used as the fallback when Groq is
# unavailable or errors, or alone if only this key is set. GOOGLE_API_KEY
# also works if that's what you already have set for other Google AI
# tooling.
GEMINI_API_KEY=

# Comma-separated origins allowed to read the API. Defaults to the four
# localhost dev/preview origins if unset -- only needed to override that.
REVORA_CORS_ORIGINS=

# Operational kill switches, both default off. See the Configuration
# section of README.md for what each one can and cannot reach.
REVORA_DISABLE_LLM=
REVORA_DISABLED_RULES=
