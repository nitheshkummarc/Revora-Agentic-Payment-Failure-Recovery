    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^26.2.0",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.1.0",
    "jsdom": "^25.0.1",
    "typescript": "^5.6.3",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
